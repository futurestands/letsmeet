{
  "name": "letsmeet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:phase3-db": "node scripts/phase3-db-security-test.mjs",
    "test:phase3-livekit": "node scripts/phase3-livekit-endpoint-test.mjs",
    "test:phase4-db": "node scripts/phase4-db-security-test.mjs",
    "test:phase5-db": "node scripts/phase5-db-security-test.mjs",
    "test:phase6-db": "node scripts/phase6-db-security-test.mjs",
    "test:staging-invites": "node --env-file=.env.staging.local scripts/staging-invitation-e2e.mjs",
    "test:load": "node scripts/load-test-meetings.mjs",
    "staging:preflight": "node scripts/staging-preflight.mjs",
    "staging:seed": "node --env-file=.env.staging.local scripts/staging-seed.mjs",
    "dev:staging": "vite --mode staging",
    "server:staging": "node --env-file=.env.staging.local server/livekit-token.mjs",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:dry": "node scripts/migrate.js --dry",
    "server:livekit-token": "node server/livekit-token.mjs"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.0",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  }
}
