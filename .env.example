# Copy to .env.staging.local for staging. Never commit that file.
#
# FRONTEND PUBLIC CONFIGURATION
# Vite exposes only VITE_ variables to the browser.
VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_staging_publishable_anon_key
VITE_LIVEKIT_URL=wss://livekit.staging.example.com
VITE_LIVEKIT_TOKEN_ENDPOINT=https://api.staging.example.com/api/livekit/token

# BACKEND / TOKEN SERVER CONFIGURATION
# These values belong only in the server secret store.
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_staging_server_only_service_role_key
STAGING_PROJECT_REF=your_staging_project_ref
STAGING_CONFIRMATION=staging:your_staging_project_ref
PRODUCTION_SUPABASE_URL=https://your-production-project.supabase.co
LIVEKIT_HOST=https://livekit.staging.example.com
LIVEKIT_API_KEY=your_staging_livekit_api_key
LIVEKIT_API_SECRET=your_staging_livekit_api_secret
ALLOWED_ORIGINS=https://app.staging.example.com
PORT=3001

# STAGING DATABASE ADMINISTRATION
# Used only by migration tooling; never expose this value to Vite.
DATABASE_URL=postgresql://postgres:your_staging_database_password@db.your-staging-project.supabase.co:5432/postgres

# ACCEPTANCE TEST IDENTITIES
# Keep real values only in .env.staging.local or a managed secret store.
STAGING_TEST_HOST_EMAIL=test-host@example.invalid
STAGING_TEST_HOST_PASSWORD=replace_in_local_secret_store
STAGING_TEST_PARTICIPANT_EMAIL=test-participant@example.invalid
STAGING_TEST_PARTICIPANT_PASSWORD=replace_in_local_secret_store

# Dual-browser Playwright E2E (optional override)
# STAGING_PREVIEW_URL=https://letsmeet-git-phase-1-saas-foundation-futurestands-projects.vercel.app

# OPTIONAL NOTIFICATION PROVIDER
# Leave unset until a real email/SMS provider is configured on the server.
# Do not put provider secrets in VITE_ variables.
# NOTIFICATION_EMAIL_PROVIDER=resend
# NOTIFICATION_EMAIL_FROM=LeTsMeet Staging <meetings@staging.example.com>
